# Sanity project settings (find these at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01
# Viewer token for server-side reads (drafts / private datasets). Never expose to the client.
SANITY_API_READ_TOKEN=
# Secret shared with the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=
